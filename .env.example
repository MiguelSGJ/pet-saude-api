WEATHER_BATCH_DAYS=366
WEATHER_CONNECT_TIMEOUT_MILLIS=10000
WEATHER_READ_TIMEOUT_MILLIS=30000
WEATHER_MAX_ATTEMPTS=3
WEATHER_RETRY_BACKOFF_MILLIS=1000
WEATHER_MAX_DAILY_PRECIPITATION_MM=500
WEATHER_MAX_WIND_SPEED_KMH=300
WEATHER_MAX_PRECIPITATION_PROVIDER_DIFFERENCE_MM=10
WEATHER_MAX_HUMIDITY_PROVIDER_DIFFERENCE_PCT_POINTS=10
WEATHER_MAX_WIND_PROVIDER_DIFFERENCE_KMH=15
WEATHER_JOB_LOCK_SECONDS=86400
WEATHER_OPEN_METEO_BASE_URL=https://archive-api.open-meteo.com/v1/archive
WEATHER_NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
